{
  "manifest_version": 3,
  "name": "CogniFlow — Workflow Continuity",
  "version": "0.2.0",
  "description": "A local-first memory layer for picking up browser work after an interruption.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "optional_permissions": ["tabs", "idle", "notifications"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open CogniFlow"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
